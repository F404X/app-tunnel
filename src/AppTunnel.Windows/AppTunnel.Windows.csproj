<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppTunnel.ico</ApplicationIcon>
    <AssemblyName>AppTunnel</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AppTunnel.Core/AppTunnel.Core.csproj" />
    <EmbeddedResource Include="Assets/Flags/*.png" LogicalName="AppTunnel.Flags.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts/*.ttf" LogicalName="AppTunnel.Fonts.%(Filename)%(Extension)" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
</Project>
